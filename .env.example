# Portal normal. A página temporária só aparece com o valor true,
# e somente depois de um novo build. Não publica nada sozinha.
VITE_MAINTENANCE_MODE=false

# Na Vercel, true faz as rotas públicas responderem HTTP 503.
# /admin e /api continuam de fora. Também só vale em um novo deploy.
MAINTENANCE_MODE=false
