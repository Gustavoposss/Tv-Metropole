{
  "functions": {
    "api/rss.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/rss",
      "destination": "/api/rss"
    },
    {
      "source": "/programacao",
      "destination": "/programacao/index.html"
    },
    {
      "source": "/programacao/",
      "destination": "/programacao/index.html"
    },
    {
      "source": "/noticias",
      "destination": "/noticias/index.html"
    },
    {
      "source": "/noticias/",
      "destination": "/noticias/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}